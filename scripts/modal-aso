#!/usr/bin/env python3
"""Launch MODAL-ASO without relying on editable .pth imports.

On macOS, Python skips .pth files that carry the UF_HIDDEN flag. That flag is
often inherited by files under `.venv`, especially on Desktop/iCloud paths, so
`from run_goal_intake import main` fails for the generated console script.
This launcher finds the project root from the script location or cwd instead.
"""

from __future__ import annotations

import sys
from pathlib import Path


def _project_root() -> Path:
    candidates: list[Path] = []
    here = Path(__file__).resolve()
    candidates.extend(here.parents)
    cwd = Path.cwd().resolve()
    candidates.append(cwd)
    candidates.extend(cwd.parents)
    seen: set[Path] = set()
    for start in candidates:
        if start in seen:
            continue
        seen.add(start)
        if (start / "run_goal_intake.py").is_file() and (start / "pyproject.toml").is_file():
            return start
    raise SystemExit(
        "Could not locate the MODAL-ASO project root (run_goal_intake.py + pyproject.toml)."
    )


def main() -> None:
    root = _project_root()
    root_text = str(root)
    if root_text not in sys.path:
        sys.path.insert(0, root_text)
    from run_goal_intake import main as run_main

    sys.exit(run_main())


if __name__ == "__main__":
    main()
